# Copy to .env and fill in. NEVER commit .env. Rotate any key that was ever pasted into a chat or ticket.

# --- API keys (only the agent container receives these) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEYS=              # comma separated free-tier key pool, rotated automatically on rate limits

# --- LLM: classifier / slot extraction / second-net red-flag check (it never writes what the caller hears) ---
LLM_ROUTE_ORDER=openai,groq          # tried in order; dead or rate-limited keys are skipped automatically
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low             # live loop: none|low (high is slow). High is used only for staff summaries.
LLM_SUMMARY_EFFORT=high
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Speech to text: Groq key pool -> OpenAI -> local faster-whisper (offline last resort) ---
STT_ROUTE_ORDER=groq,openai,local
STT_MODEL=gpt-transcribe
GROQ_STT_MODEL=whisper-large-v3-turbo
LOCAL_STT_MODEL=base

# --- Text to speech (local Kokoro, female voice) ---
TTS_URL=http://tts:8880
TTS_VOICE=af_heart
TTS_SPEED=1.05

# --- Persona / demo hospital ---
ASSISTANT_NAME=Hania
HOSPITAL_NAME=Protons Demo Hospital
EMERGENCY_NUMBER=1122
STAFF_PIN=change-me-please-8plus     # APP_ENV=prod requires 8+ chars and not a common value

# --- Database ---
POSTGRES_USER=triage
POSTGRES_PASSWORD=change_me_to_12plus_chars
POSTGRES_DB=triage

# --- Hardening / limits ---
APP_ENV=dev                 # prod refuses to start with weak secrets (see docs/DEPLOYMENT.md)
SECRET_KEY=                 # openssl rand -hex 32   (signs staff tokens)
LOG_FORMAT=text             # json in production
ALLOWED_ORIGINS=            # extra allowed browser origins, comma separated (same-origin is always allowed)
MAX_CONCURRENT_CALLS=12
MAX_CALLS_PER_IP=3
MAX_AUDIO_SECONDS=30
MAX_UTTERANCES_PER_MIN=30
MAX_CALL_SECONDS=900
IDLE_TIMEOUT_S=180
TURN_DEADLINE_S=25
